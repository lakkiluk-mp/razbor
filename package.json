{
  "name": "razbor",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.12.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "codegen": "turbo run codegen",
    "db:generate": "pnpm --filter @razbor/db db:generate",
    "db:migrate": "pnpm --filter @razbor/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @razbor/db db:migrate:deploy",
    "db:seed": "pnpm --filter @razbor/db db:seed",
    "db:studio": "pnpm --filter @razbor/db db:studio",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker/docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker/docker-compose.yml up -d",
    "docker:prod:build": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:prod:down": "docker compose -f docker/docker-compose.yml down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:prod:logs:web": "docker compose -f docker/docker-compose.yml logs -f web"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
