{
  "name": "razbor",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "graphql": "^16.12.0"
    }
  },
  "scripts": {
    "test": "turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "codegen": "turbo run codegen",
    "db:generate": "pnpm --filter @razbor/db db:generate",
    "db:migrate": "pnpm --filter @razbor/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @razbor/db db:migrate:deploy",
    "db:seed": "pnpm --filter @razbor/db db:seed",
    "db:studio": "pnpm --filter @razbor/db db:studio",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d",
    "docker:prod:build": "docker compose up -d --build",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f",
    "docker:prod:logs:server": "docker compose logs -f server",
    "price-update": "pnpm --filter @razbor/price-updater start",
    "dev:server": "pnpm --filter @razbor/server dev",
    "dev:mini-app": "pnpm --filter @razbor/mini-app dev",
    "build:server": "pnpm --filter @razbor/server build",
    "build:mini-app": "pnpm --filter @razbor/mini-app build",
    "dev:monitor": "pnpm --filter @razbor/listing-monitor dev",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
