# === Domain ===
DOMAIN=razbor.example.com

# === Database ===
POSTGRES_USER=razbor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=razbor
DATABASE_URL=postgresql://razbor:CHANGE_ME_STRONG_PASSWORD@postgres:5432/razbor

# === Redis ===
REDIS_URL=redis://redis:6379

# === Telegram Bot ===
BOT_TOKEN=CHANGE_ME_BOT_TOKEN
MINI_APP_URL=https://razbor.example.com
BOT_WEBHOOK_URL=https://razbor.example.com/api/bot-webhook

# === App ===
NODE_ENV=production

# === YooKassa ===
YOOKASSA_SHOP_ID=CHANGE_ME_SHOP_ID
YOOKASSA_SECRET_KEY=CHANGE_ME_SECRET_KEY

# === Docker ===
RUN_MIGRATIONS=true
