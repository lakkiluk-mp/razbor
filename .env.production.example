# === Domain ===
DOMAIN=razbor.example.com

# === Database ===
POSTGRES_USER=razbor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=razbor
DATABASE_URL=postgresql://razbor:CHANGE_ME_STRONG_PASSWORD@postgres:5432/razbor

# === Redis ===
REDIS_URL=redis://redis:6379

# === App ===
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://razbor.example.com
NEXT_PUBLIC_GRAPHQL_URL=https://razbor.example.com/api/graphql
NEXT_PUBLIC_FREE_CALCULATIONS_LIMIT=3

# === Docker ===
RUN_MIGRATIONS=true

# IMPORTANT: Use Docker secrets or Dokploy environment variables
# DO NOT commit real passwords to repository
